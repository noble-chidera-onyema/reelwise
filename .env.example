# Everything in reelwise runs free without any key.

# Free: your Hugging Face token gives you the free daily GPU quota for AI hero shots.
# huggingface.co -> Settings -> Access Tokens -> New token (read)
HF_TOKEN=

# Free: YouTube Data API v3 key for channel and trending analysis (10,000 free units a day).
YOUTUBE_API_KEY=

# Optional paid services. Leave empty; the free pipeline does not use them.
ANTHROPIC_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
